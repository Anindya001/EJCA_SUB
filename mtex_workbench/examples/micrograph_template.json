{
  "spec_version": 1,
  "nodes": [
    {
      "id": "n1",
      "op": "io.load_image",
      "label": "Load micrograph",
      "params": {
        "path": "micrograph.png",
        "as_gray": true,
        "pixel_size": 0.5
      },
      "inputs": {}
    },
    {
      "id": "n2",
      "op": "image.gaussian",
      "label": "Gaussian filter",
      "params": {
        "sigma": 1.0
      },
      "inputs": {
        "image": [
          "n1",
          "image"
        ]
      }
    },
    {
      "id": "n3",
      "op": "image.threshold",
      "label": "Threshold",
      "params": {
        "method": "Otsu",
        "value": 0.5,
        "invert": false
      },
      "inputs": {
        "image": [
          "n2",
          "image"
        ]
      }
    },
    {
      "id": "n4",
      "op": "image.segment",
      "label": "Segment grains",
      "params": {
        "connectivity": "4",
        "min_area": 10
      },
      "inputs": {
        "mask": [
          "n3",
          "mask"
        ]
      }
    },
    {
      "id": "n5",
      "op": "stats.grain_size",
      "label": "Grain size distribution",
      "params": {
        "phase": "",
        "exclude_border": true,
        "weighting": "Miles-Lantu\u00e9joul",
        "confidence": 0.95,
        "n_boot": 1999,
        "seed": 0
      },
      "inputs": {
        "grains": [
          "n4",
          "table"
        ]
      }
    }
  ]
